# AI Coding Mentor - Backend Environment Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Security: JWT & Cookie Configuration (Phase 6)
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=access_token
# Set AUTH_COOKIE_SECURE to True in production with HTTPS; False for local HTTP development
AUTH_COOKIE_SECURE=False
# Use 'lax' for local development / same-site deployments; 'none' requires AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=lax

# Database Configuration (MySQL - Phase 6)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/ai_coding_mentor

# AI Groq API Key & LangGraph Multi-Agent Analysis (Phase 4)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2

# Judge0 Code Execution Engine (Phase 3)
# Option A: RapidAPI Judge0 (Requires free RapidAPI key)
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Option B: Open Judge0 CE Instance (Recommended for zero-friction setup)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_TIMEOUT_SECONDS=15.0
JUDGE0_CPU_TIME_LIMIT=5.0
JUDGE0_MEMORY_LIMIT=128000
MAX_SOURCE_CODE_LENGTH=65536
MAX_STDIN_LENGTH=32768

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
